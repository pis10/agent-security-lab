# 模型：Pi 内建 provider + 该厂商原生 Key。
# 默认 Z.AI Coding 国区。换厂商只改下面两行和对应 Key。
ASL_LLM_PROVIDER=zai-coding-cn
ASL_LLM_MODEL=glm-5.3-flash
ASL_LLM_THINKING=off
ASL_LLM_TEMPERATURE=0.3

# 当前默认对应：
ZAI_CODING_CN_API_KEY=your-glm-api-key

# 其他厂商示例（选用时改 PROVIDER/MODEL，并设置该行）：
# ASL_LLM_PROVIDER=openai
# ASL_LLM_MODEL=gpt-4.1-mini
# OPENAI_API_KEY=
#
# ASL_LLM_PROVIDER=anthropic
# ASL_LLM_MODEL=claude-sonnet-4-6
# ANTHROPIC_API_KEY=
#
# ASL_LLM_PROVIDER=openrouter
# ASL_LLM_MODEL=anthropic/claude-sonnet-4
# OPENROUTER_API_KEY=

# 自建模型（OpenAI / Anthropic 兼容协议，如 vLLM、自建网关）：设置 BASE_URL 即启用，无需上面的 PROVIDER 与厂商 Key。
# OpenAI 协议写到 /v1；Anthropic 协议不带 /v1。服务不校验 Key 时 API_KEY 留空。
# ASL_LLM_BASE_URL=http://127.0.0.1:8000/v1
# ASL_LLM_API=openai-completions
# ASL_LLM_MODEL=your-model
# ASL_LLM_API_KEY=
# 服务端拒收个别请求字段时，传 Pi 的 compat 开关（JSON）：
# ASL_LLM_COMPAT={"supportsStore":false,"maxTokensField":"max_tokens"}

# 多个模型 / 自定义请求头 / 上下文长度：本项目 models.json 子集（见 README）
# ASL_MODELS_JSON=./models.json

# 容器内端口，compose 发布为 127.0.0.1:8600
# PORT=8600

# 多人使用：全局并发轮数、每轮执行时限（不含排队）、无人访问后的世界回收时间。
# 回收保留磁盘数据，下次访问恢复；可见页面的轮询视为仍在使用。
# compose 把 ASL_MAX_CONCURRENT_TURNS 同时作为报告执行容器的并发上限。
# ASL_MAX_CONCURRENT_TURNS=4
# ASL_TURN_TIMEOUT_MS=120000
# ASL_WORLD_IDLE_MS=900000
