# LLM backend (OpenAI-compatible). Default: GLM Coding Plan endpoint.
# 订阅用户用 coding 端点（按量付费端点是 /api/paas/v4，订阅流量不走那里）
ASL_LLM_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4
ASL_LLM_API_KEY=your-glm-api-key
ASL_LLM_MODEL=glm-5.3-flash
# 思考模式：disabled=快而直接（推荐）；enabled=带推理更慢更谨慎；留空=不发送该参数
ASL_LLM_THINKING=disabled

# Web server
ASL_HOST=127.0.0.1
ASL_PORT=8600

# 低温采样，目标 Agent 行为稳定（判定不随采样方差抖动）
ASL_LLM_TEMPERATURE=0.3
