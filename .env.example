# LLM backend (OpenAI-compatible). Defaults target Kimi K2.7 Code.
ASL_LLM_BASE_URL=https://api.kimi.com/coding/v1
ASL_LLM_API_KEY=sk-your-key-here
ASL_LLM_MODEL=kimi-for-coding

# Set to 1 to run fully offline with the scripted mock model
ASL_USE_MOCK_LLM=0

# Web server
ASL_HOST=127.0.0.1
ASL_PORT=8600
